{
  "name": "@keygrant/cli",
  "version": "0.4.0",
  "description": "The keygrant command: issue, find and change KeyGrant licenses and their meters, report releases, fetch a product's public keys, save license files and verify leases and license files offline.",
  "license": "MIT",
  "author": "KeyGrant",
  "homepage": "https://keygrant.dev/docs",
  "keywords": [
    "licensing",
    "license-key",
    "software-licensing",
    "cli",
    "keygrant"
  ],
  "type": "module",
  "bin": {
    "keygrant": "./dist/keygrant.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.0"
  },
  "devDependencies": {
    "@keygrant/shared": "workspace:*",
    "@types/node": "22.20.4",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keygrantdev/keygrant-cli.git",
    "directory": "cli"
  }
}
